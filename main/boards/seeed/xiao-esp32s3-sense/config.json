{
    "manufacturer": "seeed",
    "type": "xiao-esp32s3-sense",
    "target": "esp32s3",
    "builds": [
        {
            "name": "xiao-esp32s3-sense",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\"",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200",
                "CONFIG_ESPTOOLPY_MONITOR_BAUD=115200",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_CAMERA_OV3660_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_OV3660=y",
                "CONFIG_XIAOZHI_CAMERA_ALLOW_JPEG_INPUT=n",
                "CONFIG_CAMERA_OV3660_DVP_JPEG_320X240_25FPS=n",
                "CONFIG_CAMERA_OV3660_DVP_YUV422_YUYV_240X240_24FPS=y",
                "CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_YUV422_YUYV_240X240_24FPS=y"
            ]
        }
    ]
}
